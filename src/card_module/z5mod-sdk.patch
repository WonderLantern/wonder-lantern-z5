diff --git a/sdk/include/z5/overlay.h b/sdk/include/z5/overlay.h
deleted file mode 100644
index e5a9082..0000000
--- a/sdk/include/z5/overlay.h
+++ /dev/null
@@ -1,78 +0,0 @@
-/* z5mod - finished-frame overlay on the shooting page.
- *
- * Two phases, on purpose:
- *
- *   1. build  - z5_overlay_begin() .. z5_overlay_commit().  The caller appends
- *               widgets.  Only RAM is touched: no display access, no blocking,
- *               safe from the UI task, from a capture task and from a callback.
- *   2. paint  - a small task repaints the published frame every `period_ms`
- *               into the overlay layer.  Every row is written in one burst, so
- *               a display refresh can never sample half a row.
- *
- * The overlay layer is refreshed by the firmware, so the paint has to repeat
- * forever; `period_ms` trades CPU for freshness.  Budget the total widget area:
- * about 25k px is comfortable at 5 ms, about 55k px at 11 ms.
- *
- * A widget always carries its own box and background, and the paint fills that
- * box completely.  That is what keeps the panel free of gaps and stale pixels
- * from an earlier layout.
- *
- * Measured on hardware: the overlay surface accepts about 2.8 million pixels
- * per second (~11 MB/s).  Budget the widgets accordingly:
- *
- *     total widget area <= 2.8 * period_ms
- *
- * i.e. about 14k px at 5 ms, 31k px at 11 ms, 45k px at 16 ms.  Ask for a
- * cadence the area cannot sustain and the achieved rate just drops; that is
- * what z5_overlay_stats() reports.
- */
-#ifndef Z5_OVERLAY_H
-#define Z5_OVERLAY_H
-
-#include "z5.h"
-
-#define Z5_OVL_MAX_WIDGETS 12u
-#define Z5_OVL_ARENA      1024u
-
-/* Widget kinds. */
-#define Z5_OVL_RECT   1u
-#define Z5_OVL_TEXT   2u
-
-/* Colours are the layer's 32-bit format, RGBA8888 with alpha last. */
-#define Z5_RGBA(r, g, b, a) \
-    ((u32)(r) | ((u32)(g) << 8) | ((u32)(b) << 16) | ((u32)(a) << 24))
-
-typedef struct {
-    u16 period_ms;      /* repaint cadence, 5..100; 0 = default 11 ms */
-    u16 reserved;
-} z5_overlay_cfg;
-
-/* Create the state, copy the font, install the paint task.  Call from z5_main;
- * idempotent.  cfg may be NULL for the defaults.  Returns 0 on success. */
-int  z5_overlay_init(const z5_overlay_cfg *cfg);
-
-/* Change the cadence at run time (5..100 ms). */
-int  z5_overlay_set_period(u16 period_ms);
-
-/* Phase 1: start a new frame.  Discards any uncommitted widgets. */
-int  z5_overlay_begin(void);
-
-/* Phase 1: append widgets.  Return 0 on success, <0 when the frame is full. */
-int  z5_overlay_rect(u16 x, u16 y, u16 w, u16 h, u32 bg, u32 edge);
-int  z5_overlay_text(u16 x, u16 y, u16 w, u16 h, u32 bg, u32 fg, const char *s);
-
-/* Phase 2: publish the frame.  The paint task picks it up on its next tick. */
-int  z5_overlay_commit(void);
-
-typedef struct {
-    u32 paints;       /* total repaints since init */
-    u32 rate_per_s;   /* smoothed repaints per second */
-    u32 rate_min;     /* worst one-second window since init */
-    u32 paint_us;     /* average duration of one paint, microseconds */
-} z5_overlay_stats_t;
-
-/* Statistics for a debug row.  rate_per_s drops below 1000/period_ms when the
- * paint cannot keep up; paint_us says how much of the period it eats. */
-void z5_overlay_stats(z5_overlay_stats_t *out);
-
-#endif /* Z5_OVERLAY_H */
diff --git a/sdk/include/z5/state.h b/sdk/include/z5/state.h
index 60dbe26..59632ca 100644
--- a/sdk/include/z5/state.h
+++ b/sdk/include/z5/state.h
@@ -7,20 +7,48 @@
  *   - alloc() on every redraw is never freed               -> leak per frame
  *
  * Both are easy to write by accident, so the SDK offers one place for state
- * that has to survive: a block taken from the heap once, remembered in a fixed
- * word the firmware does not touch, and handed out by a bump allocator.
+ * that has to survive: a block taken from the heap once, remembered in the SDK
+ * anchor below, and handed out by a bump allocator.
  */
 #ifndef Z5_STATE_H
 #define Z5_STATE_H
 
 #include "z5.h"
 
-/* Fixed word the block pointer is remembered in. It survives module reloads
- * and is not used by the firmware (the working modules relied on it). */
-#define Z5_STATE_SLOT  0xC1811738u
+/* The SDK anchor: eight words that survive module reloads until the camera
+ * powers down (standby wake is a power-up too).
+ *
+ * They lie in the 32-byte gap between the initialised data (copied to
+ * 0xC1800000..0xC18F8120 at boot) and the zero-initialised data (from
+ * 0xC18F8140), as given by the scatter-load table at 0x10034000. No firmware
+ * code references the gap, and it was seen unchanged on a camera through
+ * shooting, playback, Bluetooth and a SnapBridge transfer. It is neither
+ * copied nor zeroed at boot, so it starts with whatever the RAM held: every
+ * word is garbage until z5_state() validates or resets the anchor.
+ *
+ * The previous slot, 0xC1811738, is field +0x30 of a firmware notification
+ * object that Bluetooth code writes; it is no longer used. */
+#define Z5_ANCHOR        0xC18F8120u
+#define Z5_ANCHOR_WORDS  8u
+#define Z5_STATE_SLOT    (Z5_ANCHOR + 0x00u)   /* state block pointer P      */
+#define Z5_STATE_CHECK   (Z5_ANCHOR + 0x04u)   /* ~P: P is valid only if set */
+#define Z5_ANCHOR_AUDIO  (Z5_ANCHOR + 0x08u)   /* audio state (hook image)   */
+#define Z5_ANCHOR_BGLOG  (Z5_ANCHOR + 0x0Cu)   /* bglog magic, control block */
+#define Z5_ANCHOR_LOG    (Z5_ANCHOR + 0x14u)   /* log ring ptr, index, count */
 
-/* The first 32 bytes are reserved for the SDK: the bump offset and the slots
- * the hook image has to reach at a fixed address. User data starts after them. */
+/* True when the anchor holds a state pointer with its check word, i.e. a
+ * z5_state() of this power-up created it. Until then every other anchor
+ * word is garbage and must not be dereferenced. */
+static inline int z5_anchor_valid(void)
+{
+    u32 p = *(volatile u32 *)Z5_STATE_SLOT;
+    return p >= 0xC1800000u && p < 0xC8700000u && *(volatile u32 *)Z5_STATE_CHECK == ~p;
+}
+
+/* The first 32 bytes are reserved for the SDK: +0x00 the bump offset, +0x04 and
+ * +0x08 the z5_ui_text() buffer and its size, +0x0C and +0x10 the
+ * z5_state_user() block and its size; the rest is free for the SDK.
+ * User data starts after them. */
 #define Z5_STATE_RESERVED 0x20u
 
 /* Total size of the block. Nothing is ever freed, so keep it modest. */
@@ -31,7 +59,15 @@
 void *z5_state(void);
 
 /* Bump-allocate inside that block. The result is zeroed, 8-byte aligned and
- * stays valid for the rest of the camera session. Returns 0 when full. */
+ * stays valid for the rest of the camera session. Returns 0 when full.
+ * Every call takes new space: z5_main runs again on every redraw, so calling
+ * this from z5_main without remembering the result uses the block up. */
 void *z5_state_alloc(u32 bytes);
 
+/* The module's own persistent structure: allocated and zeroed by the first
+ * call of a power-up, the same pointer on every later call. Put everything a
+ * module must remember across redraws in one struct and fetch it with this.
+ * A larger size than before gets a new, zeroed block. Returns 0 when full. */
+void *z5_state_user(u32 bytes);
+
 #endif /* Z5_STATE_H */
