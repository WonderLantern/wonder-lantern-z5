diff --git a/sdk/src/state.c b/sdk/src/state.c
index f20efc5..986c16d 100644
--- a/sdk/src/state.c
+++ b/sdk/src/state.c
@@ -8,13 +8,18 @@
 
 void *z5_state(void)
 {
-    u32 p = *(volatile u32 *)Z5_STATE_SLOT;
-    if (p >= 0xC1800000u && p < 0xC8700000u) return (void *)p;
+    volatile u32 *anchor = (volatile u32 *)Z5_ANCHOR;
+    u32 p = anchor[0];
+    /* The anchor starts as RAM garbage: trust it only with its check word. */
+    if (p >= 0xC1800000u && p < 0xC8700000u && anchor[1] == ~p) return (void *)p;
 
     u8 *block = (u8 *)z5_alloc(Z5_STATE_SIZE, 0);
     if (!block) return 0;
     for (u32 i = 0; i < Z5_STATE_SIZE; i++) block[i] = 0;
-    *(volatile u32 *)Z5_STATE_SLOT = (u32)block;
+    /* A new block means a new session: the other anchor words are garbage. */
+    for (u32 i = 2; i < Z5_ANCHOR_WORDS; i++) anchor[i] = 0u;
+    anchor[1] = ~(u32)block;
+    anchor[0] = (u32)block;
     return block;
 }
 
@@ -29,3 +34,21 @@ void *z5_state_alloc(u32 bytes)
     *(u32 *)(block + USED_OFFSET) = used + need;
     return block + DATA_START + used;
 }
+
+/* Reserved words remembering the z5_state_user() block (see state.h). */
+#define USER_PTR   0x0Cu
+#define USER_SIZE  0x10u
+
+void *z5_state_user(u32 bytes)
+{
+    u8 *block = (u8 *)z5_state();
+    if (!block) return 0;
+    u32 *ptr = (u32 *)(block + USER_PTR);
+    u32 *size = (u32 *)(block + USER_SIZE);
+    if (*ptr && *size >= bytes) return (void *)*ptr;
+    void *user = z5_state_alloc(bytes);
+    if (!user) return 0;
+    *ptr = (u32)user;
+    *size = bytes;
+    return user;
+}
