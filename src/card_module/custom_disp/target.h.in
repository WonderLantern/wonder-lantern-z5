/* Fixed custom DISP profile; native checks are generated from the pinned base. */
/* Share the upstream audio controller's rotating ready queue. Both overlay
 * tasks sleep; a lower priority can starve behind its always-ready loop. */
#define Z5_CUSTOM_DISP_TASK_PRIORITY 0x30u
#define Z5_PROBE_SELECTOR (*(volatile const u8 *)0xC1821714u)
#define Z5_PROBE_CALLBACK(i) (((volatile const u32 *)0xC1821718u)[(i)])
#define Z5_PROBE_TARGET_MATCH() @PROBE@
#define Z5_PROBE_INACTIVE 4u
#define Z5_CUSTOM_DISP_SHOOTING_PAGE() (*(volatile const u32 *)0xC1819F90u == 0xC18216A0u)
#define Z5_PROBE_SET_CALLBACK(i, v) (((volatile u32 *)0xC1821718u)[(i)] = (v))
#define Z5_PROBE_EXPECTED(i) ((i) == 0u ? 0x102F4819u : (i) == 1u ? 0x102F5DF5u : (i) == 2u ? 0x102F5ED7u : (i) == 3u ? 0x102F5ED7u : (i) == 4u ? 0x102F5F09u : 0u)
#define Z5_OVERLAY_SNAPSHOT 0xC20282B4u
#define Z5_OVERLAY_OUTPUT (*(volatile const u8 *)0xC1821781u)
#define Z5_OVERLAY_RAM_LOW 0xC1800000u
#define Z5_OVERLAY_RAM_HIGH 0xC8700000u
